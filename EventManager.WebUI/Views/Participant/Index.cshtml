@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Attendee Management";
}

<style>
    /* CSS ONLY FOR ATTENDEES MANAGEMENT PAGE */
    /* (Layout styles are already in _Layout.cshtml) */

    /* Color variables specific to this page */
    :root {
        --primary: #FFC107;
        --primary-dark: #FFA000;
        --primary-light: #FFECB3;
        --secondary: #212121;
        --light: #FFFDE7;
        --dark: #212121;
        --gray: #757575;
        --light-gray: #F5F5F5;
        --border: #E0E0E0;
        --danger: #D32F2F;
        --success: #388E3C;
        --warning: #F57C00;
        --info: #1976D2;
    }

    /* Alert styles specific to this page */
    .alert-area {
        position: fixed;
        top: 20px;
        right: 20px;
        width: 400px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .alert {
        border-radius: 10px;
        padding: 18px 20px;
        border: 1px solid transparent;
        display: flex;
        align-items: flex-start;
        animation: slideInRight 0.4s ease-out;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    }

    .alert-success {
        background: #d4edda;
        border-color: #b1d8b7;
        color: #155724;
        border-left: 5px solid #28a745;
    }

    .alert-danger {
        background: #f8d7da;
        border-color: #f1b0b7;
        color: #721c24;
        border-left: 5px solid #dc3545;
    }

    .alert-warning {
        background: #fff3cd;
        border-color: #ffeaa7;
        color: #856404;
        border-left: 5px solid #ffc107;
    }

    .alert-icon {
        font-size: 24px;
        margin-right: 15px;
        margin-top: 2px;
    }

    .alert-title {
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 5px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .alert-message {
        font-size: 14px;
        line-height: 1.5;
    }

    .btn-close-alert {
        background: none;
        border: none;
        color: inherit;
        opacity: 0.7;
        cursor: pointer;
        font-size: 18px;
    }

    @@keyframes slideInRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes fadeOut {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
        }
    }

    /* Modal Error Styles for this page only */
    .modal-error-area {
        display: none;
        margin: 15px 0;
    }

    .modal-error {
        background: #f8d7da;
        border: 1px solid #f1b0b7;
        border-left: 5px solid #dc3545;
        color: #721c24;
        border-radius: 8px;
        padding: 15px;
        margin: 10px 0;
    }

    /* Page-specific layout */
    .menu-bar {
        display: flex;
        background-color: white;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 20px;
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.05);
    }

    .menu-itemlocal {
        flex: 1;
        text-align: center;
        padding: 15px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
        color: var(--gray);
        border-right: 1px solid var(--border);
    }

        .menu-itemlocal:last-child {
            border-right: none;
        }

        .menu-itemlocal.active {
            background-color: var(--primary);
            color: var(--dark);
        }

        .menu-itemlocal:hover:not(.active) {
            background-color: var(--primary-light);
        }

    .content-section {
        display: none;
        background-color: white;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 1px 5px rgba(0,0,0,0.05);
        margin-bottom: 20px;
        min-height: 600px;
    }

        .content-section.active {
            display: block;
        }

    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--border);
    }

    .section-title {
        font-size: 1.2rem;
        margin-bottom: 15px;
        color: var(--dark);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Table styles for this page */
    .table-responsive {
        overflow-x: auto;
        border-radius: 8px;
        box-shadow: 0 1px 5px rgba(0,0,0,0.05);
        margin-top: 15px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        font-size: 0.85rem;
    }

    th, td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid var(--border);
    }

    th {
        background-color: var(--light-gray);
        font-weight: 600;
        color: var(--dark);
    }

    tr:hover {
        background-color: var(--primary-light);
    }

    #attendeesTable td:last-child {
        white-space: nowrap;
    }

    /* Form styles for this page */
    .form-row {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
    }

    .form-col {
        flex: 1;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        color: var(--dark);
    }

    input, select, textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: 5px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(255, 193, 7, 0.2);
        }

    .is-invalid {
        border-color: var(--danger) !important;
    }

    /* Button styles for this page */
    .btn {
        padding: 10px 18px;
        border: none;
        border-radius: 5px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: var(--primary);
        color: var(--dark);
    }

        .btn-primary:hover {
            background-color: var(--primary-dark);
        }

    .btn-secondary {
        background-color: var(--light-gray);
        color: var(--dark);
    }

        .btn-secondary:hover {
            background-color: var(--border);
        }

    .btn-success {
        background-color: var(--success);
        color: white;
    }

        .btn-success:hover {
            background-color: #2e7d32;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

    .btn-danger {
        background-color: var(--danger);
        color: white;
    }

    .btn-warning {
        background-color: var(--warning);
        color: white;
    }

    .btn-sm {
        padding: 6px 12px;
        font-size: 0.8rem;
    }

    /* Modal styles for this page */
    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
    }

        .modal.show {
            display: flex;
            align-items: center;
            justify-content: center;
        }

    .modal-content {
        background-color: white;
        width: 90%;
        max-width: 900px;
        max-height: 90vh;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        display: flex;
        flex-direction: column;
    }

    .modal-header {
        padding: 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-title {
        margin: 0;
        font-size: 1.3rem;
        color: var(--dark);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 28px;
        cursor: pointer;
        color: var(--gray);
        line-height: 1;
    }

    .modal-body {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
    }

    .modal-footer {
        padding: 15px 20px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

    /* Upload area for this page */
    .upload-area {
        border: 2px dashed var(--border);
        border-radius: 8px;
        padding: 40px 20px;
        text-align: center;
        margin: 20px 0;
        cursor: pointer;
        transition: all 0.3s ease;
        background-color: var(--light-gray);
    }

        .upload-area:hover,
        .upload-area.drag-over {
            border-color: var(--primary);
            background-color: var(--primary-light);
        }

    .upload-icon {
        font-size: 48px;
        color: var(--gray);
        margin-bottom: 15px;
    }

    /* Mobile responsive for this page */
    @@media (max-width: 768px) {
        .alert-area {
            width: 90%;
            left: 5%;
            right: 5%;
        }

        .menu-bar {
            flex-direction: column;
        }

        .menu-itemlocal {
            border-right: none;
            border-bottom: 1px solid var(--border);
        }

        .action-bar {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .table-responsive {
            border: 1px solid var(--border);
        }

        table {
            min-width: 800px;
        }

        #exportExcelBtn {
            width: 100%;
            justify-content: center;
        }

        .form-row {
            flex-direction: column;
            gap: 10px;
        }

        .btn-sm {
            padding: 5px 8px;
            font-size: 0.75rem;
            margin: 2px;
        }

        .modal-content {
            width: 95%;
            margin: 10px;
        }
    }

    @@media (max-width: 480px) {
        .modal-content {
            width: 100%;
            height: 100%;
            max-height: 100%;
            border-radius: 0;
        }
    }
</style>


<div class="container-fluid">
    <div class="card">
        <div class="card-body p-4 p-lg-5">

        <div class="menu-bar">
            <div class="menu-itemlocal active" data-section="manage-attendees">Manage Attendees</div>
            <div class="menu-itemlocal" data-section="attendees-list">Attendees List</div>
        </div>

        <div class="alert-area"></div>

        <div class="content-section active" id="manage-attendees">
            <div class="action-bar">
                <h2 class="section-title"><i class="fas fa-user-edit"></i> Manage Attendees</h2>
                <div>
                    <button class="btn btn-primary" id="bulkUploadBtn">
                        <i class="fas fa-file-upload"></i> Bulk Upload
                    </button>
                </div>
            </div>
                <form id="attendeeForm">
                    <input type="hidden" id="EventId" name="EventId" value="@ViewBag.EventId" />

                    <div class="form-row">
                        <div class="form-col">
                            <label for="firstName">First Name *</label>
                            <input type="text" id="firstName" name="FirstName" required>
                        </div>
                        <div class="form-col">
                            <label for="lastName">Last Name *</label>
                            <input type="text" id="lastName" name="LastName" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-col">
                            <label for="email">Email Address *</label>
                            <input type="email" id="email" name="Email" required>
                        </div>
                        <div class="form-col">
                            <label for="phone">Phone Number</label>
                            <input type="tel" id="phone" name="Phone">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-col">
                            <label for="company">Company</label>
                            <input type="text" id="company" name="Company">
                        </div>
                        <div class="form-col">
                            <label for="department">Department</label>
                            <input type="text" id="department" name="Department">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-col">
                            <label for="country">Country</label>
                            <input type="text" id="country" name="Country">
                        </div>
                        <div class="form-col">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="notes">Additional Notes</label>
                        <textarea id="notes" name="Notes" rows="2"></textarea>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">Save Attendee</button>
                    </div>
                </form>
            </div>

            <div class="content-section" id="attendees-list">
                <div class="action-bar">
                    <h2 class="section-title"><i class="fas fa-list-alt"></i> Attendees List</h2>
                    <div>
                        <button class="btn btn-success" id="exportExcelBtn">
                            <i class="fas fa-file-excel"></i> Export All to Excel
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <!-- ADD THIS WRAPPER -->
                    <table id="attendeesTable" class="table table-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Company</th>
                                <th>Department</th>
                                <th>Country</th>
                                <th>Notes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="attendeesTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="bulkUploadModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title"><i class="fas fa-file-excel"></i> Excel Bulk Upload</h3>
            <button class="modal-close" id="modalClose">&times;</button>
        </div>
        <div class="modal-body">
            <p>Upload an Excel file to create or update multiple attendees at once.</p>

            <div class="upload-area" id="dropZone">
                <div class="upload-icon">
                    <i class="fas fa-file-upload"></i>
                </div>
                <h3>Drag & Drop your Excel file here</h3>
                <p>or</p>
                <button class="btn btn-primary" id="browseBtn">
                    <i class="fas fa-folder-open"></i> Browse Files
                </button>
                <input type="file" id="fileInput" accept=".xlsx, .xls, .csv" style="display: none;">
            </div>

            <!-- Error Message Area in Modal -->
            <div id="modalErrorArea" class="modal-error-area" style="display: none;">
                <div class="modal-error">
                    <div style="display: flex; align-items: flex-start;">
                        <i class="fas fa-exclamation-triangle" style="font-size: 24px; margin-right: 15px; margin-top: 2px; flex-shrink: 0;"></i>
                        <div style="flex: 1; min-width: 0;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                                <strong style="font-size: 16px;">Import Failed</strong>
                                <button type="button" id="closeModalError" style="background: none; border: none; color: inherit; opacity: 0.7; cursor: pointer; font-size: 18px;">&times;</button>
                            </div>
                            <div id="modalErrorMessage" style="font-size: 14px; margin-bottom: 8px;"></div>
                            <div id="modalErrorStats" style="display: flex; gap: 10px; margin-bottom: 12px; flex-wrap: wrap;"></div>
                            <div id="modalErrorActions" style="margin-top: 8px;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="attendee-list">
                <h3 class="section-title"><i class="fas fa-list"></i> Preview</h3>
                <div class="table-container">
                    <table id="previewTable">
                        <thead>
                            <tr>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Company</th>
                                <th>Department</th>
                                <th>Country</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Preview data will be inserted here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" id="downloadTemplateBtn">
                <i class="fas fa-download"></i> Download Template
            </button>
            <button class="btn btn-primary" id="modalUploadBtn">
                <i class="fas fa-upload"></i> Upload & Process
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let previewDataTable = null;
            let attendeesDataTable = null;
            let allAttendeesData = [];
            function initializeDataTable() {
                if ($.fn.DataTable.isDataTable('#previewTable')) {
                    previewDataTable.destroy();
                    $('#previewTable').empty();
                }

                $('#previewTable').html(`
                    <thead>
                        <tr>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Company</th>
                            <th>Department</th>
                            <th>Country</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                `);

                previewDataTable = $('#previewTable').DataTable({
                    paging: true,
                    pageLength: 10,
                    lengthMenu: [10, 25, 50, 100],
                    searching: true,
                    ordering: true,
                    info: true,
                    autoWidth: false,
                    processing: false,
                    language: {
                        processing: '<i class="fas fa-spinner fa-spin fa-2x"></i> Loading...',
                        emptyTable: 'No data available in table',
                        info: 'Showing _START_ to _END_ of _TOTAL_ entries',
                        infoEmpty: 'Showing 0 to 0 of 0 entries',
                        infoFiltered: '(filtered from _MAX_ total entries)',
                        lengthMenu: 'Show _MENU_ entries',
                        search: 'Search:',
                        paginate: {
                            first: 'First',
                            last: 'Last',
                            next: 'Next',
                            previous: 'Previous'
                        }
                    },
                    dom: '<"top"lf>rt<"bottom"ip><"clear">',
                    scrollY: '400px',
                    scrollCollapse: true,
                    order: [[0, 'asc']]
                });
            }

              function exportToExcel(data) {
            if (!data || data.length === 0) {
                showAlert('danger', 'No data to export');
                return;
            }

            try {
                const wb = XLSX.utils.book_new();
                const excelData = [];
                const now = new Date();
                const day = String(now.getDate()).padStart(2, '0');
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const year = now.getFullYear();
                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');

                // Title row
                excelData.push([`ATTENDEES LIST REPORT - Exported on: ${day}/${month}/${year}, ${hours}:${minutes}`]);
                excelData.push([]); // Empty row

                // Headers row
                excelData.push([
                    'ID',
                    'First Name',
                    'Last Name',
                    'Email',
                    'Phone',
                    'Company',
                    'Department',
                    'Country',
                    'Notes'
                ]);

                // Data rows
                data.forEach(attendee => {
                    excelData.push([
                        attendee.participantId || '',
                        attendee.firstName || '',
                        attendee.lastName || '',
                        attendee.email || '',
                        attendee.phone || '',
                        attendee.company || '',
                        attendee.department || '',
                        attendee.country || '',
                        attendee.notes || ''
                    ]);
                });

                const ws = XLSX.utils.aoa_to_sheet(excelData);

                ws['!cols'] = [
                    { wch: 8 }, 
                    { wch: 15 },
                    { wch: 15 },
                    { wch: 25 },
                    { wch: 15 },
                    { wch: 20 },
                    { wch: 15 },
                    { wch: 15 },
                    { wch: 30 }
                ];

                ws['!merges'] = [{ s: { r: 0, c: 0 }, e: { r: 0, c: 9 } }];

                XLSX.utils.book_append_sheet(wb, ws, "Attendees");

                const filename = `Attendees_${day}-${month}-${year}_${hours}-${minutes}.xlsx`;

                XLSX.writeFile(wb, filename);
                showAlert('success', 'Excel exported successfully');

            } catch (error) {
                console.error('Export error:', error);
                showAlert('danger', 'Export failed: ' + error.message);
            }
        }


                   function initializeAttendeesDataTable() {
            if ($.fn.DataTable.isDataTable('#attendeesTable')) {
                attendeesDataTable.destroy();
                $('#attendeesTable tbody').empty();
            }

            attendeesDataTable = $('#attendeesTable').DataTable({
                paging: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                responsive: true, // ADD THIS - makes it work on mobile
                language: {
                    processing: '<i class="fas fa-spinner fa-spin fa-2x"></i> Loading...',
                    emptyTable: 'No attendees found',
                    info: 'Showing _START_ to _END_ of _TOTAL_ attendees',
                    infoEmpty: 'Showing 0 to 0 of 0 attendees',
                    infoFiltered: '(filtered from _MAX_ total attendees)',
                    lengthMenu: 'Show _MENU_ attendees',
                    search: 'Search:',
                    paginate: {
                        first: 'First',
                        last: 'Last',
                        next: 'Next',
                        previous: 'Previous'
                    }
                },
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="fas fa-file-excel"></i> Export',
                        className: 'btn btn-success btn-sm',
                        exportOptions: {
                            modifier: {
                                search: 'none',
                                page: 'all'
                            },
                            columns: ':visible'
                        },
                        title: 'Attendees Report',
                        filename: function() {
                            const now = new Date();
                            const day = String(now.getDate()).padStart(2, '0');
                            const month = String(now.getMonth() + 1).padStart(2, '0');
                            const year = now.getFullYear();
                            return `Attendees_${day}-${month}-${year}`;
                        }
                    }
                ],
                columnDefs: [
                    {
                        targets: 0,
                        width: "5%",
                        searchable: false,
                        responsivePriority: 2
                    },
                    {
                        targets: 1,
                        width: "15%",
                        responsivePriority: 1
                    },
                    {
                        targets: 2,
                        width: "15%",
                        responsivePriority: 1
                    },
                    {
                        targets: 3,
                        width: "12%",
                        responsivePriority: 3
                    },
                    {
                        targets: 4,
                        width: "12%",
                        responsivePriority: 4
                    },
                    {
                        targets: 5,
                        width: "12%",
                        responsivePriority: 4
                    },
                    {
                        targets: 6,
                        width: "10%",
                        responsivePriority: 5
                    },
                    {
                        targets: 7,
                        width: "14%",
                        responsivePriority: 6,
                        render: function(data, type, row) {
                            if (type === 'display') {
                                return data && data.length > 50 ?
                                    data.substr(0, 50) + '...' :
                                    data || '';
                            }
                            return data;
                        }
                    },
                    {
                        targets: 8,
                        width: "10%",
                        orderable: false,
                        searchable: false,
                        responsivePriority: 1
                    }
                ],
                order: [[0, 'desc']]
            });
        }

            initializeDataTable();
            initializeAttendeesDataTable();

            function showAlert(type, message, totalRecords = null, processedRecords = null, errorFileUrl = null) {
            const alertId = 'alert-' + Date.now();
            const isSuccess = type === 'success';

            // Check if we should show stats (when totalRecords is provided)
            const showStats = totalRecords !== null;

            // Convert to numbers if showing stats
            const totalNum = showStats ? Number(totalRecords) || 0 : 0;
            const processedNum = showStats ? Number(processedRecords) || 0 : 0;
            const failedNum = showStats && isSuccess ? totalNum - processedNum : processedRecords || 0;

            // Configuration for different alert types
            const config = {
                success: {
                    title: 'Success!',
                    icon: 'fa-check-circle',
                    primaryStatIcon: 'fa-check-circle',
                    primaryStatClass: 'stat-success',
                    timeout: 8000
                },
                danger: {
                    title: 'Error',
                    icon: 'fa-exclamation-triangle',
                    primaryStatIcon: 'fa-times-circle',
                    primaryStatClass: 'stat-danger',
                    timeout: 10000
                }
            };

            const currentConfig = config[type] || config.danger;

            let alertHtml = `
                <div id="${alertId}" class="alert alert-${type}">
                    <i class="fas ${currentConfig.icon} alert-icon"></i>
                    <div class="alert-content">
                        <div class="alert-title">
                            <span>${currentConfig.title}</span>
                            <button class="btn-close-alert" onclick="closeAlert('${alertId}')">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="alert-message">${message}</div>`;

            // Add stats section only if needed
            if (showStats) {
                alertHtml += `
                        <div class="alert-stats">
                            <span class="stat-badge stat-secondary">
                                <i class="fas fa-users"></i> Total: ${totalNum}
                            </span>`;

                if (isSuccess) {
                    alertHtml += `
                            <span class="stat-badge stat-success">
                                <i class="fas ${currentConfig.primaryStatIcon}"></i> Imported: ${processedNum}
                            </span>`;
                } else {
                    alertHtml += `
                            <span class="stat-badge stat-danger">
                                <i class="fas ${currentConfig.primaryStatIcon}"></i> Failed: ${failedNum}
                            </span>`;
                }

                alertHtml += `</div>`;
            }

            // Add error report section only for error alerts with valid URL
            if (!isSuccess && errorFileUrl && errorFileUrl !== 'null' && errorFileUrl.trim() !== '') {
                alertHtml += `
                        <div class="alert-actions">
                            <a href="${errorFileUrl}" class="btn-download-error" target="_blank" download>
                                <i class="fas fa-download"></i> Download Error Report
                            </a>
                        </div>`;
            }

            alertHtml += `</div></div>`;

            $('.alert-area').append(alertHtml);
            setTimeout(() => closeAlert(alertId), currentConfig.timeout);
        }

            window.closeAlert = function(alertId) {
                const alert = $('#' + alertId);
                if (alert.length) {
                    alert.css('animation', 'fadeOut 0.5s ease forwards');
                    setTimeout(() => alert.remove(), 500);
                }
            };

            function showModalError(message, totalRecords, failedRecords, errorFileUrl) {
                const errorArea = $('#modalErrorArea');
                const messageEl = $('#modalErrorMessage');
                const statsEl = $('#modalErrorStats');
                const actionsEl = $('#modalErrorActions');

                // Convert to numbers
                const totalNum = totalRecords || 0;
                const failedNum = failedRecords || 0;

                // Set message
                messageEl.text(message || 'Unknown error');

                // Set stats
                statsEl.html(`
                    <span style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; background-color: rgba(108, 117, 125, 0.15); color: #383d41;">
                        <i class="fas fa-users"></i> Total: ${totalNum}
                    </span>
                    <span style="padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; background-color: rgba(220, 53, 69, 0.15); color: #721c24;">
                        <i class="fas fa-times-circle"></i> Failed: ${failedNum}
                    </span>
                `);

                // Set actions (download link)
                if (errorFileUrl && errorFileUrl !== 'null' && errorFileUrl.trim() !== '' && errorFileUrl !== 'undefined') {
                    actionsEl.html(`
                        <div style="display: flex; gap: 10px; align-items: center;">
                            <a href="${errorFileUrl}" style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background-color: rgba(220, 53, 69, 0.1); color: #dc3545; border: 1px solid #dc3545; border-radius: 6px; font-size: 13px; font-weight: 600; text-decoration: none; transition: all 0.3s ease;" target="_blank" download>
                                <i class="fas fa-download"></i> Download Error Report
                            </a>
                            <button type="button" class="btn btn-secondary" id="retryUploadBtn" style="padding: 8px 16px; font-size: 13px; border: 1px solid #6c757d; background-color: #f8f9fa; color: #212529; border-radius: 6px; cursor: pointer;">
                                <i class="fas fa-redo"></i> Try Different File
                            </button>
                        </div>
                    `);

                    // Add click handler for retry button
                    setTimeout(() => {
                        $('#retryUploadBtn').off('click').on('click', function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            hideModalError();
                            fileInput.val('');

                            // Reset drop zone
                            dropZone.html(`
                                <div class="upload-icon"><i class="fas fa-file-upload"></i></div>
                                <h3>Drag & Drop your Excel file here</h3>
                                <p>or</p>
                                <button class="btn btn-primary" id="browseBtn">
                                    <i class="fas fa-folder-open"></i> Browse Files
                                </button>`);

                            // Clear DataTable
                            if (previewDataTable) {
                                previewDataTable.clear().draw();
                            }

                            // Re-attach browse button click event
                            setTimeout(() => {
                                $('#browseBtn').off('click').on('click', function(e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    fileInput.click();
                                });
                            }, 100);
                        });
                    }, 100);
                }

                // Show error area
                errorArea.show();
            }

            function hideModalError() {
                $('#modalErrorArea').hide();
                $('#modalErrorMessage').empty();
                $('#modalErrorStats').empty();
                $('#modalErrorActions').empty();
            }

            $('.menu-itemlocal').click(function () {
                $('.menu-itemlocal').removeClass('active');
                $(this).addClass('active');
                $('.content-section').removeClass('active');
                $('#' + $(this).data('section')).addClass('active');

                if ($(this).data('section') === 'attendees-list') {
                    // Initialize or reload DataTable
                    if (!attendeesDataTable || !$.fn.DataTable.isDataTable('#attendeesTable')) {
                        initializeAttendeesDataTable();
                    }
                    loadParticipants();
                } else if ($(this).data('section') === 'manage-attendees') {
                    $('#attendeeForm')[0].reset();
                    $('#attendeeForm').removeData('participant-id');
                    $('#attendeeForm button[type="submit"]').text('Save Attendee');
                }
            });

            $('#attendeeForm').validate({
                rules: {
                    FirstName: { required: true, minlength: 2 },
                    LastName: { required: true, minlength: 2 },
                    Email: { required: true, email: true }
                },
                messages: {
                    FirstName: { required: "First Name is required", minlength: "First Name must be at least 2 characters" },
                    LastName: { required: "Last Name is required", minlength: "Last Name must be at least 2 characters" },
                    Email: { required: "Email Address is required", email: "Please enter a valid email address" }
                },
                errorClass: "text-danger",
                errorPlacement: (error, element) => error.insertAfter(element),
                highlight: (element) => $(element).addClass('is-invalid'),
                unhighlight: (element) => $(element).removeClass('is-invalid'),
                submitHandler: saveParticipant
            });

            function saveParticipant() {
                const dto = {
                    ParticipantId: $('#attendeeForm').data('participant-id') || 0,
                    EventId: Number($('#EventId').val()) || 0,
                    FirstName: $('#firstName').val(),
                    LastName: $('#lastName').val(),
                    Email: $('#email').val(),
                    Phone: $('#phone').val(),
                    Company: $('#company').val(),
                    Department: $('#department').val(),
                    Country: $('#country').val(),
                    Notes: $('#notes').val()
                };

                $.ajax({
                    url: '@Url.Action("Save", "Participant")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dto),
                    success: function () {
                        showAlert('success', 'Participant saved successfully!');
                        $('#attendeeForm')[0].reset();
                        $('#attendeeForm').removeData('participant-id');
                        $('#attendeeForm button[type="submit"]').text('Save Attendee');
                        loadParticipants();
                        $('.menu-itemlocal[data-section="attendees-list"]').click();
                    },
                    error: function (xhr) {
                        const errorMessage = xhr.responseJSON?.message || 'Error saving participant';
                        showAlert('danger', errorMessage);
                    }
                });
            }

             function loadParticipants() {
            // Show loading state
            if (attendeesDataTable) {
                attendeesDataTable.clear().draw();
            }

            $.ajax({
                url: '@Url.Action("LoadParticipants", "Participant")',
                type: 'GET',
                data: { eventId: $('#EventId').val() },
                success: function (participants) {
                    // Store the original data for export
                    allAttendeesData = participants || [];

                    // Initialize DataTable if not already initialized
                    if (!attendeesDataTable || !$.fn.DataTable.isDataTable('#attendeesTable')) {
                        initializeAttendeesDataTable();
                    }

                    // Clear existing data
                    attendeesDataTable.clear();

                    if (!participants?.length) {
                        attendeesDataTable.draw();
                        return;
                    }

                    // Add data to DataTable
                    participants.forEach(p => {
                        attendeesDataTable.row.add([
                            p.participantId,
                            `${p.firstName} ${p.lastName}`,
                            p.email || '',
                            p.phone || '',
                            p.company || '',
                            p.department || '',
                            p.country || '',
                            p.notes || '',
                            `
                                <button class="btn btn-warning btn-sm edit-btn" data-id="${p.participantId}">Edit</button>
                                <button class="btn btn-danger btn-sm delete-btn" data-id="${p.participantId}">Delete</button>
                            `
                        ]);
                    });

                    // Draw the table
                    attendeesDataTable.draw();
                },
                error: function (xhr) {
                    showAlert('danger', 'Error loading participants');
                    if (attendeesDataTable) {
                        attendeesDataTable.clear().draw();
                    }
                }
            });
        }

                 $('#exportExcelBtn').click(function() {
            if (!allAttendeesData || allAttendeesData.length === 0) {
                showAlert('warning', 'No attendees data to export. Please load attendees first.');
                return;
            }

            // Add loading state
            const originalText = $(this).html();
            $(this).html('<i class="fas fa-spinner fa-spin"></i> Exporting...').prop('disabled', true);

            exportToExcel(allAttendeesData);

            // Re-enable after 2 seconds
            setTimeout(() => {
                $(this).html(originalText).prop('disabled', false);
            }, 2000);
        });
            $(document).on('click', '.edit-btn', function () {
                debugger;
                const participantId = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("Details", "Participant")',
                    type: 'GET',
                    data: { id: participantId },
                    success: function (participant) {
                        $('.menu-itemlocal[data-section="manage-attendees"]').click();
                        $('#EventId').val(participant.eventId);
                        $('#firstName').val(participant.firstName);
                        $('#lastName').val(participant.lastName);
                        $('#email').val(participant.email);
                        $('#phone').val(participant.phone);
                        $('#company').val(participant.company);
                        $('#department').val(participant.department);
                        $('#country').val(participant.country);
                        $('#notes').val(participant.notes);
                        $('#attendeeForm').data('participant-id', participant.participantId);
                        $('#attendeeForm button[type="submit"]').text('Update Attendee');
                    },
                    error: function () {
                        showError('Error fetching participant details.', 0, 0);
                    }
                });
            });

            $(document).on('click', '.delete-btn', function () {
                if (!confirm('Are you sure you want to delete this participant?')) return;

                const participantId = $(this).data('id');
                $.ajax({
                    url: '@Url.Action("Delete", "Participant")',
                    type: 'POST',
                    data: { id: participantId },
                    success: function () {
                        showAlert('success', 'Participant deleted successfully!');
                        loadParticipants(); 
                    },
                    error: function (xhr) {
                        showAlert('danger', 'Error deleting participant');
                    }
                });
            });

            const modal = $('#bulkUploadModal');
            const fileInput = $('#fileInput');
            const dropZone = $('#dropZone');
            const modalUploadBtn = $('#modalUploadBtn');

            $('#bulkUploadBtn').click(() => {
                hideModalError();
                modal.addClass('show');
                initializeDataTable();
            });

            $('#modalClose').click(() => {
                hideModalError();
                modal.removeClass('show');
            });

            modal.click((e) => {
                if ($(e.target).is('#bulkUploadModal')) {
                    hideModalError();
                    modal.removeClass('show');
                }
            });

            $(document).on('click', '#closeModalError', function() {
                hideModalError();
            });

            $(document).on('click', '#browseBtn', function(e) {
                e.preventDefault();
                e.stopPropagation();
                fileInput.click();
            });

            fileInput.change(handleFileSelect);

            dropZone.on('dragover dragleave drop', function(e) {
                e.preventDefault();
                e.stopPropagation();
                if (e.type === 'dragover') $(this).addClass('drag-over');
                else if (e.type === 'dragleave') $(this).removeClass('drag-over');
                else if (e.type === 'drop') {
                    $(this).removeClass('drag-over');
                    const files = e.originalEvent.dataTransfer.files;
                    if (files.length) {
                        fileInput[0].files = files;
                        handleFileSelect({ target: fileInput[0] });
                    }
                }
            });

            function handleFileSelect(e) {
                const file = e.target.files[0];
                if (!file) return;

                const fileExtension = '.' + file.name.split('.').pop().toLowerCase();
                if (!['.xlsx', '.xls', '.csv'].includes(fileExtension)) {
                    showModalError('Please select a valid Excel file (.xlsx, .xls, .csv)', 0, 0);
                    return;
                }

                hideModalError();

                dropZone.html(`
                    <div class="upload-icon" style="color: var(--primary);">
                        <i class="fas fa-file-excel"></i>
                    </div>
                    <h3>${file.name}</h3>
                    <p><i class="fas fa-spinner fa-spin"></i> Reading file...</p>
                    <button class="btn btn-secondary" id="changeFileBtn" style="margin-top: 10px;">
                        <i class="fas fa-exchange-alt"></i> Change File
                    </button>`);

                if (previewDataTable) {
                    previewDataTable.clear().draw();
                }

                parseExcelFile(file);
            }

            function parseExcelFile(file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        const data = new Uint8Array(e.target.result);
                        const workbook = XLSX.read(data, { type: 'array' });
                        const worksheet = workbook.Sheets[workbook.SheetNames[0]];
                        const jsonData = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

                        if (jsonData.length <= 1) {
                            dropZone.find('p').text(`${(file.size/1024).toFixed(2)} KB • No data rows`);
                            if (previewDataTable) {
                                previewDataTable.clear().draw();
                            }
                            return;
                        }

                        const headers = jsonData[0] || [];
                        const attendeeData = [];

                        for (let i = 1; i < jsonData.length; i++) {
                            const row = jsonData[i];
                            const hasData = row.some(cell => cell?.toString().trim());
                            if (!hasData) continue;

                            const attendee = {
                                firstName: '',
                                lastName: '',
                                email: '',
                                phone: '',
                                company: '',
                                department: '',
                                country: '',
                                notes: ''
                            };

                            for (let j = 0; j < headers.length && j < row.length; j++) {
                                const header = (headers[j] || '').toString().toLowerCase();
                                const value = (row[j] || '').toString().trim();
                                if (!value) continue;

                                if (header.includes('first')) attendee.firstName = value;
                                else if (header.includes('last')) attendee.lastName = value;
                                else if (header.includes('email')) attendee.email = value;
                                else if (header.includes('phone')) attendee.phone = value;
                                else if (header.includes('company')) attendee.company = value;
                                else if (header.includes('department') || header.includes('dept')) attendee.department = value;
                                else if (header.includes('country')) attendee.country = value;
                                else if (header.includes('note')) attendee.notes = value;
                            }

                            if (attendee.firstName || attendee.lastName || attendee.email) {
                                attendeeData.push(attendee);
                            }
                        }

                        dropZone.find('p').html(`
                            <i class="fas fa-check-circle" style="color: var(--success);"></i>
                            ${(file.size/1024).toFixed(2)} KB • ${attendeeData.length} attendees found`);

                        renderDataTable(attendeeData);

                    } catch (error) {
                        dropZone.find('p').html(`<i class="fas fa-times-circle" style="color: var(--danger);"></i> ${(file.size/1024).toFixed(2)} KB • Error`);
                        showModalError(`Error parsing file: ${error.message}`, 0, 0);
                    }
                };
                reader.onerror = () => {
                    dropZone.find('p').html('<i class="fas fa-times-circle" style="color: var(--danger);"></i> File read error');
                    showModalError('Could not read the file. Please try again.', 0, 0);
                };
                reader.readAsArrayBuffer(file);
            }

            function renderDataTable(data) {
                if (!previewDataTable) {
                    initializeDataTable();
                }
                previewDataTable.clear();

                if (!data?.length) {
                    previewDataTable.draw();
                    return;
                }

                data.forEach(row => {
                    previewDataTable.row.add([
                        escapeHtml(row.firstName || ''),
                        escapeHtml(row.lastName || ''),
                        escapeHtml(row.email || ''),
                        escapeHtml(row.phone || ''),
                        escapeHtml(row.company || ''),
                        escapeHtml(row.department || ''),
                        escapeHtml(row.country || ''),
                        escapeHtml(row.notes || '')
                    ]);
                });

                previewDataTable.draw();
                updateDataTableInfo(data.length);
            }

            function updateDataTableInfo(totalCount) {
                setTimeout(() => {
                    const infoElement = $('.dataTables_info');
                    if (infoElement.length) {
                        if (totalCount === 0) {
                            infoElement.text('Showing 0 to 0 of 0 entries');
                        } else {
                            const pageInfo = previewDataTable.page.info();
                            const start = pageInfo.start + 1;
                            const end = pageInfo.end;

                            infoElement.text(`Showing ${start} to ${end} of ${totalCount} attendees`);
                        }
                    }
                }, 100);
            }

            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            $(document).on('click', '#downloadTemplateBtn', function(e) {
                e.preventDefault();
                window.location.href = '@Url.Action("DownloadTemplate", "Participant")';
            });

            modalUploadBtn.click(function () {
                const file = fileInput[0].files[0];

                if (!file) {
                    showModalError('Please select a file first.', 0, 0);
                    return;
                }

                const fileExtension = '.' + file.name.split('.').pop().toLowerCase();
                if (!['.xlsx', '.xls', '.csv'].includes(fileExtension)) {
                    showModalError('Please select a valid Excel file (.xlsx, .xls, .csv)', 0, 0);
                    return;
                }

                const originalText = modalUploadBtn.html();
                modalUploadBtn
                    .html('<i class="fas fa-spinner fa-spin"></i> Uploading...')
                    .prop('disabled', true);

                hideModalError();

                const formData = new FormData();
                formData.append('file', file);
                formData.append('EventId', $('#EventId').val());

                $.ajax({
                    url: '@Url.Action("ImportExcel", "Participant")',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        hideModalError();
                        modal.removeClass('show');

                        if (response.success) {
                            showAlert(
                                'success',
                                response.message || 'File uploaded successfully!',
                                response.totalRecords || 0,
                                response.importedRecords || 0
                            );
                            loadParticipants();
                        } else {
                            showAlert(
                                'danger',
                                response.message || 'Import failed.',
                                response.totalRecords || 0,
                                response.failedRecords || 0,
                                response.errorFileUrl
                            );
                            modal.addClass('show');
                        }
                    },

                    error: function (xhr, status, error) {
                        console.log("AJAX Error Status:", status);
                        console.log("AJAX Error:", error);
                        console.log("Response:", xhr.responseJSON);

                        if (xhr.status === 400 && xhr.responseJSON) {
                            showModalError(
                                xhr.responseJSON.message || 'Validation failed',
                                xhr.responseJSON.totalRecords || 0,
                                xhr.responseJSON.failedRecords || 0,
                                xhr.responseJSON.errorFileUrl
                            );
                            modal.addClass('show');
                        }
                        else if (xhr.status === 404) {
                            showModalError(
                                'Server endpoint not found. Please check the URL.',
                                0, 0
                            );
                            modal.addClass('show');
                        }
                        else if (xhr.status === 500) {
                            showModalError(
                                'Server error occurred. Please try again later.',
                                0, 0
                            );
                            modal.addClass('show');
                        }
                        else {
                            showModalError(
                                'Error during import: ' + (error || 'Unknown error'),
                                0, 0
                            );
                            modal.addClass('show');
                        }
                    },

                    complete: function () {
                        modalUploadBtn.html(originalText).prop('disabled', false);
                    }
                });
            });

            $(document).on('click', '#changeFileBtn', function(e) {
                e.preventDefault();
                e.stopPropagation();

                hideModalError();
                fileInput.val('');
                
                dropZone.html(`
                    <div class="upload-icon"><i class="fas fa-file-upload"></i></div>
                    <h3>Drag & Drop your Excel file here</h3>
                    <p>or</p>
                    <button class="btn btn-primary" id="browseBtn">
                        <i class="fas fa-folder-open"></i> Browse Files
                    </button>
                    <input type="file" id="fileInput" accept=".xlsx, .xls, .csv" style="display: none;">`);

                if (previewDataTable) {
                    previewDataTable.clear().draw();
                    setTimeout(() => {
                        $('.dataTables_info').text('Showing 0 to 0 of 0 entries');
                    }, 100);
                }

                setTimeout(() => {

                    $('#browseBtn').off('click').on('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        fileInput.click();
                    });
                    
                    fileInput.off('change').on('change', handleFileSelect);
                    
                    dropZone.off('dragover dragleave drop')
                        .on('dragover', function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            $(this).addClass('drag-over');
                        })
                        .on('dragleave', function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            $(this).removeClass('drag-over');
                        })
                        .on('drop', function(e) {
                            e.preventDefault();
                            e.stopPropagation();
                            $(this).removeClass('drag-over');
                            const files = e.originalEvent.dataTransfer.files;
                            if (files.length) {
                                fileInput[0].files = files;
                                handleFileSelect({ target: fileInput[0] });
                            }
                        });
                }, 100);
            });
        });
    </script>
}