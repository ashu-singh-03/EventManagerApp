                            }

                            // Re-attach browse button click event
                            setTimeout(() => {
                                $('#browseBtn').off('click').on('click', function(e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    fileInput.click();
                                });
                            }, 100);
                        });
                    }, 100);
                }

                // Show error area
                errorArea.show();
