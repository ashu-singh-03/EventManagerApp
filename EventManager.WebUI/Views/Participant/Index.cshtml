            function showAlert(type, message, totalRecords = null, processedRecords = null, errorFileUrl = null) {
            const alertId = 'alert-' + Date.now();
            const isSuccess = type === 'success';

            // Check if we should show stats (when totalRecords is provided)
            const showStats = totalRecords !== null;

            // Convert to numbers if showing stats
            const totalNum = showStats ? Number(totalRecords) || 0 : 0;
            const processedNum = showStats ? Number(processedRecords) || 0 : 0;
            const failedNum = showStats && isSuccess ? totalNum - processedNum : processedRecords || 0;

            // Configuration for different alert types
            const config = {
                success: {
                    title: 'Success!',
                    icon: 'fa-check-circle',
                    primaryStatIcon: 'fa-check-circle',
                    primaryStatClass: 'stat-success',
                    timeout: 8000
                },
                danger: {
                    title: 'Error',
                    icon: 'fa-exclamation-triangle',
                    primaryStatIcon: 'fa-times-circle',
                    primaryStatClass: 'stat-danger',
                    timeout: 10000
                }
            };

            const currentConfig = config[type] || config.danger;

            let alertHtml = `
                <div id="${alertId}" class="alert alert-${type}">
                    <i class="fas ${currentConfig.icon} alert-icon"></i>
                    <div class="alert-content">
                        <div class="alert-title">
                            <span>${currentConfig.title}</span>
                            <button class="btn-close-alert" onclick="closeAlert('${alertId}')">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <div class="alert-message">${message}</div>`;

            // Add stats section only if needed
            if (showStats) {
                alertHtml += `
                        <div class="alert-stats">
                            <span class="stat-badge stat-secondary">
                                <i class="fas fa-users"></i> Total: ${totalNum}
                            </span>`;

                if (isSuccess) {
                    alertHtml += `
                            <span class="stat-badge stat-success">
                                <i class="fas ${currentConfig.primaryStatIcon}"></i> Imported: ${processedNum}
                            </span>`;
                } else {
                    alertHtml += `
                            <span class="stat-badge stat-danger">
                                <i class="fas ${currentConfig.primaryStatIcon}"></i> Failed: ${failedNum}
                            </span>`;
                }

                alertHtml += `</div>`;
            }

            // Add error report section only for error alerts with valid URL
            if (!isSuccess && errorFileUrl && errorFileUrl !== 'null' && errorFileUrl.trim() !== '') {
                alertHtml += `
                        <div class="alert-actions">
                            <a href="${errorFileUrl}" class="btn-download-error" target="_blank" download>
                                <i class="fas fa-download"></i> Download Error Report
                            </a>
                        </div>`;
            }

            alertHtml += `</div></div>`;

            $('.alert-area').append(alertHtml);
            setTimeout(() => closeAlert(alertId), currentConfig.timeout);
        }

