            return new Promise((resolve, reject) => {
                $.ajax({
                    url: '/ParticipantCommunication/GenerateIdCard',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        QrCode: participantData.QrCode,
                        IsPrintCenter: true
                    }),
                    success: async function(res) {
                        if (!res.success) {
                            reject(new Error('API returned success: false'));
                            return;
                        }

                        htmlContent =res.idCardHtml;
                         const element = document.createElement('div');

                            // Extract body content if present
                            if (htmlContent.includes('<body>')) {
                                const bodyMatch = htmlContent.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
                                element.innerHTML = bodyMatch && bodyMatch[1] ? bodyMatch[1] : htmlContent;
                            } else {
                                element.innerHTML = htmlContent;
                            }

                                 //const element = document.createElement('div'); // const element = document.createElement('div');
                element.innerHTML = htmlContent;
                // Clone the element to avoid affecting the display
                const elementToPrint = element.cloneNode(true);
                elementToPrint.style.background = 'white';
                elementToPrint.style.margin = '0';
                elementToPrint.style.boxShadow = 'none';
                elementToPrint.style.border = 'none';







                        // Create a hidden iframe to render the HTML
                        const iframe = document.createElement('iframe');
                        //iframe.style.cssText = 'position:absolute;left:-9999px;top:-9999px;width:105mm;height:148mm;border:none;';

                        document.body.appendChild(iframe);

                        iframe.onload = async function() {
                            try {
                                // Write HTML to iframe
                                iframe.contentDocument.open();
                                iframe.contentDocument.write(res.idCardHtml);
                                iframe.contentDocument.close();

                                // Wait for iframe to render
                                await new Promise(resolve => setTimeout(resolve, 300));

                                const element = iframe.contentDocument.body;
                                 const elementToPrint = element.cloneNode(true);

                                // 3. Apply print styles
                                elementToPrint.style.background = 'white';
                                elementToPrint.style.margin = '0';
                                elementToPrint.style.boxShadow = 'none';
                                elementToPrint.style.border = 'none';
                                elementToPrint.style.color = '#000'; // Add for better print contrast

                                // 4. Append to IFRAME's body, not main document body
                                iframe.contentDocument.body.innerHTML = ''; // Clear iframe first
                                iframe.contentDocument.body.appendChild(elementToPrint);
                                 const options = {
                                 margin: 0,
                                 image: { type: 'jpeg', quality: 0.98 },
                                 html2canvas: {
                                     scale: 3, // Higher scale for better quality
                                     useCORS: true,
                                     backgroundColor: '#ffffff',
                                     logging: false,
                                     width: 105 * 3.78, // Convert mm to pixels (105mm * 3.78px/mm)
                                     height: 148 * 3.78  // Convert mm to pixels
                                 },
                                 jsPDF: {
                                     unit: 'mm',
                                     format: 'a6',
                                     orientation: 'portrait'
                                 }
                             }




                                const pdfBlob = await html2pdf()
                                    .set(options)
                                    .from(elementToPrint)
                                    .toPdf()
                                    .output('blob');

                                // Add to zip
                                const safeName = participantData.ParticipantName
                                    .replace(/[^a-zA-Z0-9\s-]/g, '')
                                    .replace(/\s+/g, '_');
                                const filename = `${safeName}_${participantData.QrCode}.pdf`;

                                zip.file(filename, pdfBlob);
                                console.log(`Added to ZIP: ${filename} (${pdfBlob.size} bytes)`);

                                // Cleanup
                                document.body.removeChild(iframe);
                                resolve();

                            } catch (error) {
                                document.body.removeChild(iframe);
                                reject(error);
                            }
                        };

                        // Trigger iframe load
                        iframe.src = 'about:blank';
                    },
                    error: function(xhr, status, error) {
                        reject(new Error(`AJAX error: ${error}`));
                    }
                });
            });
        }


