         });


         

            // Initialize
            initializeDataTable();
        });

          function generateAndDownloadZip(zip, selectedData, button, originalButtonHtml, successCount, failedCount) {
            button.html('<i class="fas fa-spinner fa-spin"></i> Creating ZIP file...');

            console.log('Generating ZIP file...');

            // Check if zip has any files
            const fileCount = Object.keys(zip.files).length;

            if (fileCount === 0) {
                console.error('No files to add to ZIP');
                button.html(originalButtonHtml).prop('disabled', false);
               // toastr.error('No PDFs were generated. Please try again.');
                return;
            }

            // Generate ZIP file
            zip.generateAsync({
                type: "blob",
                compression: "DEFLATE",
                compressionOptions: {
                    level: 6
                }
            })
            .then(function(content) {
                console.log('ZIP generated successfully, size:', content.size);

                // Create filename
                const timestamp = new Date().toISOString().slice(0, 19).replace(/[:]/g, '-');
                const filename = `ID_Cards_${timestamp}.zip`;

                // Download using FileSaver.js
                saveAs(content, filename);

                // Restore button
                button.html(originalButtonHtml).prop('disabled', false);

                // Show success message
                if (failedCount > 0) {
                    //toastr.warning(`Downloaded ${successCount} of ${selectedData.length} ID cards. ${failedCount} failed.`);
                } else {
                    //toastr.success(`Successfully downloaded ${successCount} ID cards`);
                }
            })
            .catch(function(error) {
                console.error('Error creating ZIP:', error);
                button.html(originalButtonHtml).prop('disabled', false);
                //toastr.error('Error creating ZIP file. Please try again.');
            });
        }

                function generateParticipantPDF(participantData, zip) {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: '/ParticipantCommunication/GenerateIdCard',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        QrCode: participantData.QrCode,
                        IsPrintCenter: true
                    }),
                    success: async function(res) {
                        try {
                            if (!res.success) {
                                reject(new Error('API returned success: false'));
                                return;
                            }

                            const htmlContent = res.idCardHtml; // You need to get the HTML from response
                            const element = document.createElement('div');

                            // Parse HTML content
                            if (htmlContent.includes('<body>')) {
                                const bodyMatch = htmlContent.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
                                if (bodyMatch && bodyMatch[1]) {
                                    element.innerHTML = bodyMatch[1];
                                } else {
                                    element.innerHTML = htmlContent;
                                }
                            } else {
                                element.innerHTML = htmlContent;
                            }

                            // Clone the element for printing
                       const elementToPrint = element.cloneNode(true);
        elementToPrint.style.background = 'white';
        elementToPrint.style.margin = '0';
        elementToPrint.style.boxShadow = 'none';
        elementToPrint.style.border = 'none';


                            // Append to body temporarily
                            document.body.appendChild(elementToPrint);
                            document.body.appendChild(element);

                            const opt = {
                                margin: 0,
                                filename: participantData.ParticipantName.replace(/\s+/g, '_') + '_Business_Card.pdf',
                                image: { type: 'jpeg', quality: 0.98 },
                                html2canvas: {
                                    scale: 3,
                                    useCORS: true,
                                    backgroundColor: '#ffffff',
                                    logging: false,
                                    width: 105 * 3.78,
                                    height: 148 * 3.78
                                },
                                jsPDF: {
                                    unit: 'mm',
                                    format: 'a6',
                                    orientation: 'portrait'
                                }
                            };

                            // Wait a moment for any images to load
                            setTimeout(() => {
                                html2pdf()
                                    .set(opt)
                                    .from(elementToPrint)
                                    .outputPdf('blob')
                                    .then((pdfBlob) => {
                                        // Clean up DOM elements
                                        document.body.removeChild(elementToPrint);
                                        document.body.removeChild(element);

                                        // Create safe filename
                                        const safeName = participantData.ParticipantName
                                            .replace(/[^a-zA-Z0-9\s-]/g, '')
                                            .replace(/\s+/g, '_');
                                        const filename = `${safeName}_${participantData.QrCode}.pdf`;

                                        // Add to ZIP
                                        zip.file(filename, pdfBlob);
                                        console.log(`Added to ZIP: ${filename} (${pdfBlob.size} bytes)`);
                                        resolve(pdfBlob);
                                    })
                                    .catch(error => {
                                        console.error('PDF generation failed:', error);
                                        // Clean up on error
                                        document.body.removeChild(elementToPrint);
                                        document.body.removeChild(element);
                                        reject(error);
                                    });
                            }, 500);

                        } catch (error) {
                            // Ensure cleanup on error
                            const elements = document.querySelectorAll('div[style*="-9999px"]');
                            elements.forEach(el => {
                                if (el.parentNode === document.body) {
                                    document.body.removeChild(el);
                                }
                            });

                            // Also remove any other temporary elements
                            const tempElements = document.querySelectorAll('div[style*="position: absolute"]');
                            tempElements.forEach(el => {
                                if (el.parentNode === document.body && el.style.left === '-9999px') {
                                    document.body.removeChild(el);
                                }
                            });

                            reject(error);
                        }
                    },
                    error: function(xhr, status, error) {
                        reject(new Error(`AJAX request failed: ${status} - ${error}`));
                    }
                });
            });
        }
