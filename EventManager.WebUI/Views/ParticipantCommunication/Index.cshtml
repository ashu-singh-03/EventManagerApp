}




        async function generateAndDownloadPdf(htmlContent, name) {
          return new Promise((resolve, reject) => {
            try {
              // Create container
              const container = document.createElement('div');
              container.innerHTML = htmlContent;

              // Force white background & clean layout
              container.style.background = '#ffffff';
              container.style.margin = '0';
              container.style.padding = '0';

              // Append once
              document.body.appendChild(container);

              const opt = {
                margin: 0,
                filename: name.replace(/\s+/g, '_') + '_Business_Card.pdf',

                image: { type: 'jpeg', quality: 0.98 },

                html2canvas: {
                  scale: 2,                 // High DPI, safe
                  useCORS: true,
                  backgroundColor: '#ffffff',
                  logging: false
                },

                jsPDF: {
                  unit: 'mm',
                  format: [105, 148],       // A6
                  orientation: 'portrait'
                }
              };

              // Give images/fonts time to load
              setTimeout(() => {
                html2pdf()
                  .set(opt)
                  .from(container)
                  .save()
                  .then(() => {
                    document.body.removeChild(container);
                    resolve();
                  })
                  .catch(err => {
                    document.body.removeChild(container);
                    reject(err);
                  });
              }, 300);

            } catch (error) {
              reject(error);
            }
          });
        }



             // Function to download single PDF (modified from your original code)
        async function downloadSinglePDF(id, name) {
            try {
                // Update counter (if needed)
                incrementCounter(id, 'download');

                const response = await fetch('/ParticipantCommunication/GenerateIdCard', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        QrCode: id.toString(),
                        IsPrintCenter: true
                    })
                });

                const result = await response.json();

                if (!result.success) {
                    throw new Error(result.message || 'Failed to generate ID card');
                }

                // Generate PDF
                await generateAndDownloadPdf(result.idCardHtml, name);

                // Add a small delay between downloads to prevent overwhelming the server
                await new Promise(resolve => setTimeout(resolve, 500));

                return true;

            } catch (error) {
                console.error(`Error downloading PDF for ${name}:`, error);
                throw error;
            }
        }

