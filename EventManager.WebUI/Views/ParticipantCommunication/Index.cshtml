                $(document).on('click', '.download-pdf-btn', function() {
                const btn = $(this);
                const pName = btn.data('name');
                const originalHtml = btn.html();

                $.ajax({
                    url: '/ParticipantCommunication/GenerateIdCard',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        QrCode: btn.data('id').toString(),
                        IsPrintCenter: true
                    }),
                    success: function(res) {
                        if (res.success) {

                // Show loading state
                btn.html('<i class="fas fa-spinner fa-spin"></i> Generating PDF...').prop('disabled', true);

                // Get the content to convert to PDF
                const element = document.createElement('div');
                element.innerHTML = res.idCardHtml;
                // Clone the element to avoid affecting the display
                const elementToPrint = element.cloneNode(true);
                elementToPrint.style.background = 'white';
                elementToPrint.style.margin = '0';
                elementToPrint.style.boxShadow = 'none';
                elementToPrint.style.border = 'none';



        // //                 element.innerHTML = res.idCardHtml;

                // Append to body temporarily
                document.body.appendChild(elementToPrint);

                // Options for html2pdf
                const options = {
                    margin: 0,
                    filename: pName.replace(/\s+/g, '_') + '_Business_Card.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: {
                        scale: 3, // Higher scale for better quality
                        useCORS: true,
                        backgroundColor: '#ffffff',
                        logging: false,
                        width: 105 * 3.78, // Convert mm to pixels (105mm * 3.78px/mm)
                        height: 148 * 3.78  // Convert mm to pixels
                    },
                    jsPDF: {
                        unit: 'mm',
                        format: 'a6',
                        orientation: 'portrait'
                    }
                };

                // Generate PDF
                html2pdf()
                    .set(options)
                    .from(elementToPrint)
                    .save()
                    .then(() => {
                        // Remove temporary element
                        document.body.removeChild(elementToPrint);

                        // Restore button
                        btn.html(originalHtml).prop('disabled', false);
                    })
                    .catch(error => {
                        console.error('PDF generation error:', error);

                        // Try alternative method
                        tryAlternativeMethod(pName, elementToPrint, btn, originalHtml);
                    });

                    }
                    },
                    complete: function() {
                        btn.html(oldHtml).prop('disabled', false);
                    }
                });
            });

            function tryAlternativeMethod(pName, element, btn, originalHtml) {
                // Alternative method with different settings
                const options = {
                    margin: [5, 5, 5, 5],
                    filename: pName.replace(/\s+/g, '_') + '_Business_Card.pdf',
                    html2canvas: {
                        scale: 2,
                        useCORS: true,
                        backgroundColor: '#ffffff',
                        width: 794, // A6 in pixels at 72 DPI
                        height: 1123
                    },
                    jsPDF: {
                        unit: 'px',
                        format: [794, 1123], // A6 in pixels
                        orientation: 'portrait'
                    }
                };

                html2pdf()
                    .set(options)
                    .from(element)
                    .save()
                    .then(() => {
                        document.body.removeChild(element);
                        btn.html(originalHtml).prop('disabled', false);
                    })
                    .catch(error => {
                        console.error('Alternative method also failed:', error);
                        document.body.removeChild(element);
                        btn.html(originalHtml).prop('disabled', false);
                        alert('Error generating PDF. Please try printing the page directly (Ctrl+P).');
                    });
            }

        function printIdCard(htmlContent) {
            if (!htmlContent || htmlContent.trim() === '') return;

            console.log('Auto-printing ID card...');

            // Modify HTML to add print color adjustments
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = htmlContent;

            // Add print color adjustment to all styled elements
            const allElements = tempDiv.querySelectorAll('*');
            allElements.forEach(el => {
                const currentStyle = el.getAttribute('style') || '';
                if (currentStyle) {
                    el.setAttribute('style', currentStyle + '; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color-adjust: exact !important;');
                }
            });

            const iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            document.body.appendChild(iframe);

            const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
            iframeDoc.open();
            iframeDoc.write(`
              
                    ${tempDiv.innerHTML}

            `);
            iframeDoc.close();

            iframe.onload = function() {
                setTimeout(() => {
                    iframe.contentWindow.focus();
                    iframe.contentWindow.print();

                    setTimeout(() => {
                        document.body.removeChild(iframe);
                    }, 1000);
                }, 500);
            };
        }
            setInterval(() => {
                participantsTable.ajax.reload(null, false);
            }, 60000);
        });


