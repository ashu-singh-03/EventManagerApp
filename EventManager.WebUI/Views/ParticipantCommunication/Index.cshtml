@{
    ViewData["Title"] = "Participants Communication";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<!-- Add these in your <head> or before your script -->
<!-- FileSaver.js for saving files -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<!-- JSZip for creating zip files -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<style>
    /* Counter Badge Styles */
    .btn-with-badge {
        position: relative;
        display: inline-block;
    }

    .counter-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        font-size: 0.6rem;
        min-width: 16px;
        height: 16px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 3px;
        border: 2px solid white;
    }

    .print-counter {
        background-color: #dc3545;
        color: white;
    }

    .download-counter {
        background-color: #17a2b8;
        color: white;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
        justify-content: center;
    }
</style>

<div class="container-fluid py-4">
    <div class="card mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <a href="/Event/Index" class="btn btn-outline-warning btn-sm">
                        <i class="fas fa-arrow-left"></i> Back
                    </a>
                    <div>
                        <h1 class="h5 mb-1 fw-bold">Participants Communication</h1>
                        <p class="text-muted small mb-0">Manage participants and access credentials</p>
                    </div>
                </div>
                <button class="btn btn-primary btn-sm" id="generateAllPdfs" style="display:none;">
                    <i class="fas fa-file-pdf"></i> Generate All PDFs
                </button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-white border-bottom p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold text-dark">Participants List</h5>
                </div>
                <div class="bulk-actions-container" style="display: none;">
                    <div class="btn-group">
                        <button type="button" class="btn btn-outline-dark btn-sm dropdown-toggle"
                                data-bs-toggle="dropdown">
                            <span class="badge bg-warning text-dark rounded-pill selected-count">0</span> Selected
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="#" id="bulkGeneratePdf">
                                    <i class="fas fa-file-pdf text-danger me-2"></i>Generate PDFs
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="#" id="clearSelection">
                                    <i class="fas fa-times me-2"></i>Clear Selection
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0" id="participantsTable">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 50px;">
                            <input class="form-check-input" type="checkbox" id="selectAllCheckbox">
                        </th>
                        <th>Code</th>
                        <th>Participant</th>
                        <th>Contact</th>
                        <th>Company</th>
                        <th>Ticket Type</th>
                        <th>Access Points</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Table rows will be populated here -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Counter storage
            const COUNTER_KEY = 'participant_counters';

            function getCounters() {
                const stored = localStorage.getItem(COUNTER_KEY);
                return stored ? JSON.parse(stored) : {};
            }

            function saveCounters(counters) {
                localStorage.setItem(COUNTER_KEY, JSON.stringify(counters));
            }

            function getCounter(participantId, type) {
                const counters = getCounters();
                return counters[`${participantId}_${type}`] || 0;
            }

            function incrementCounter(participantId, type) {
                const counters = getCounters();
                const key = `${participantId}_${type}`;
                counters[key] = (counters[key] || 0) + 1;
                saveCounters(counters);

                // Update badge display
                const badge = $(`.counter-badge[data-id="${participantId}"][data-type="${type}"]`);
                if (badge.length) {
                    badge.text(counters[key]).show();
                }

                return counters[key];
            }

            let participantsTable;
            let selectedParticipants = new Set();

            // Initialize DataTable
            function initializeDataTable() {
                participantsTable = $('#participantsTable').DataTable({
                    ajax: {
                        url: '/ParticipantCommunication/LoadParticipantsWithAssignments',
                        type: 'GET',
                        dataSrc: function(response) {
                            return response.success ? response.data : [];
                        }
                    },
                    columns: [
                        {
                            data: null,
                            className: 'text-center',
                            orderable: false,
                            render: function(data) {
                                return `<input type="checkbox" class="participant-checkbox" data-id="${data.participantId}">`;
                            }
                        },
                        {
                            data: 'participantCode',
                            className: 'text-center',
                            render: function(data) {
                                return data ? `<span class="badge bg-primary">${data}</span>` : 'N/A';
                            }
                        },
                        {
                            data: null,
                            render: function(data) {
                                return `<div>${data.fullName}<br><small class="text-muted">${data.email}</small></div>`;
                            }
                        },
                        {
                            data: 'phone',
                            render: function(data) {
                                return data || 'N/A';
                            }
                        },
                        {
                            data: 'company',
                            render: function(data) {
                                return data || 'N/A';
                            }
                        },
                        {
                            data: 'ticketTypes',
                            render: function(data) {
                                return data && data !== 'Not Assigned' ?
                                    `<span class="badge bg-warning">${data}</span>` :
                                    '<span class="badge bg-secondary">Not Assigned</span>';
                            }
                        },
                        {
                            data: 'accessPoints',
                            render: function(data) {
                                if (!data || data === 'No Access') {
                                    return '<span class="badge bg-secondary">No Access</span>';
                                }
                                const points = data.split(', ');
                                return points.map(point => `<span class="badge bg-info me-1">${point}</span>`).join('');
                            }
                        },
                        {
                            data: null,
                            className: 'text-center',
                            orderable: false,
                            render: function(data) {
                                const printCount = getCounter(data.participantId, 'print');
                                const downloadCount = getCounter(data.participantId, 'download');

                                return `
                                    <div class="action-buttons">
                                        <button class="btn btn-outline-warning btn-sm email-btn"
                                                data-id="${data.participantId}" data-email="${data.email}"
                                                data-name="${data.fullName}" title="Send Email">
                                            <i class="fas fa-envelope"></i>
                                        </button>

                                        <div class="btn-with-badge">
                                            <button class="btn btn-outline-primary btn-sm print-btn"
                                                    data-id="${data.participantId}" data-name="${data.fullName}"
                                                    title="Print ID Card">
                                                <i class="fas fa-print"></i>
                                            </button>
                                            <span class="counter-badge print-counter" data-id="${data.participantId}"
                                                  data-type="print" ${printCount > 0 ? '' : 'style="display: none;"'}>
                                                ${printCount}
                                            </span>
                                        </div>

                                        <div class="btn-with-badge">
                                            <button class="btn btn-outline-success btn-sm download-btn"
                                                    data-id="${data.participantId}" data-name="${data.fullName}"
                                                    title="Download PDF">
                                                <i class="fas fa-file-download"></i>
                                            </button>
                                            <span class="counter-badge download-counter" data-id="${data.participantId}"
                                                  data-type="download" ${downloadCount > 0 ? '' : 'style="display: none;"'}>
                                                ${downloadCount}
                                            </span>
                                        </div>
                                    </div>
                                `;
                            }
                        }
                    ],
                    language: {
                        emptyTable: "No participants found",
                        zeroRecords: "No matching participants found"
                    },
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [5, 10, 25, 50],
                    order: [[1, 'asc']]
                });
            }

            // Checkbox functionality
            $(document).on('change', '.participant-checkbox', function() {
                const id = $(this).data('id');
                if ($(this).prop('checked')) {
                    selectedParticipants.add(id);
                } else {
                    selectedParticipants.delete(id);
                    $('#selectAllCheckbox').prop('checked', false);
                }
                updateBulkUI();
            });

            $('#selectAllCheckbox').on('change', function() {
                const checked = $(this).prop('checked');
                $('.participant-checkbox').prop('checked', checked);

                if (checked) {
                    participantsTable.rows({ search: 'applied' }).every(function() {
                        selectedParticipants.add(this.data().participantId);
                    });
                } else {
                    selectedParticipants.clear();
                }
                updateBulkUI();
            });

            function updateBulkUI() {
                const count = selectedParticipants.size;
                $('.selected-count').text(count);
                $('.bulk-actions-container').toggle(count > 0);
               // $('#generateAllPdfs').toggle(count === 0);
            }

            // Clear selection
            $('#clearSelection').on('click', function(e) {
                e.preventDefault();
                selectedParticipants.clear();
                $('.participant-checkbox').prop('checked', false);
                $('#selectAllCheckbox').prop('checked', false);
                updateBulkUI();
            });

            // Email button
            $(document).on('click', '.email-btn', function(e) {
                e.preventDefault();
                const btn = $(this);
                const original = btn.html();
                btn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

                $.ajax({
                    url: '/ParticipantCommunication/SendEmailToParticipant',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ participantId: btn.data('id') }),
                    success: function(res) {
                        alert(res.success ? 'Email sent!' : 'Error: ' + res.message);
                    },
                    error: function() {
                        alert('Failed to send email');
                    },
                    complete: function() {
                        btn.html(original).prop('disabled', false);
                    }
                });
            });

            // Print button
            $(document).on('click', '.print-btn', function(e) {
                e.preventDefault();
                e.stopPropagation();

                const btn = $(this);
                const id = btn.data('id');
                const name = btn.data('name');

                // Update counter
                incrementCounter(id, 'print');

                // Show loading
                const original = btn.html();
                btn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

                // Print logic
                $.ajax({
                    url: '/ParticipantCommunication/GenerateIdCard',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        QrCode: id.toString(),
                        AccessPoint: "Print Center",
                        IsPrintCenter: true
                    }),
                    success: function(res) {
                        if (res.success && res.idCardHtml) {
                            // Print function
                            const iframe = document.createElement('iframe');
                            iframe.style.display = 'none';
                            document.body.appendChild(iframe);
                            const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
                            iframeDoc.open();
                            iframeDoc.write(res.idCardHtml);
                            iframeDoc.close();
                            iframe.onload = function() {
                                setTimeout(() => {
                                    iframe.contentWindow.focus();
                                    iframe.contentWindow.print();
                                    setTimeout(() => document.body.removeChild(iframe), 1000);
                                }, 500);
                            };
                        } else {
                            alert('Error generating ID card');
                        }
                    },
                    error: function() {
                        alert('Failed to generate ID card');
                    },
                    complete: function() {
                        setTimeout(() => {
                            btn.html(original).prop('disabled', false);
                        }, 1000);
                    }
                });

                return false;
            });

            // Download button
        $(document).on('click', '.download-btn', async function(e) {
            e.preventDefault();
            e.stopPropagation();

            const btn = $(this);
            const id = btn.data('id');
            const name = btn.data('name');

            // Update counter
            incrementCounter(id, 'download');

            // Show loading
            const original = btn.html();
            btn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

            try {
                const response = await fetch('/ParticipantCommunication/GenerateIdCard', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        QrCode: id.toString(),
                        IsPrintCenter: true
                    })
                });

                const result = await response.json();
                console.log('Server response:', result);

                if (!result.success) {
                    throw new Error(result.message || 'Failed to generate ID card');
                }

                // Generate PDF from HTML on client side
                await generateAndDownloadPdf(result.idCardHtml, name);

                btn.html(original).prop('disabled', false);

            } catch (error) {
                console.error('Download error:', error);
                alert(`Failed to generate PDF: ${error.message}`);
                btn.html(original).prop('disabled', false);
            }
        });

        async function generateAndDownloadPdfttt(htmlContent, name) {
  return new Promise((resolve, reject) => {
    try {
      const parser = new DOMParser();
      const doc = parser.parseFromString(htmlContent, 'text/html');

      const styles = doc.querySelectorAll('style, link[rel="stylesheet"]');
      const bodyContent = doc.body.innerHTML;

      const styleContainer = document.createElement('div');
      styles.forEach(style => styleContainer.appendChild(style.cloneNode(true)));
      document.head.appendChild(styleContainer);

      // ✅ MATCH PDF SIZE EXACTLY
      const wrapper = document.createElement('div');
      wrapper.style.width = '95mm';
      wrapper.style.height = '53mm';
      wrapper.style.margin = '0';
      wrapper.style.padding = '0';
      wrapper.style.overflow = 'hidden';
      wrapper.style.background = '#fff';
      wrapper.style.position = 'fixed';
      wrapper.style.left = '0';
      wrapper.style.top = '0';

      wrapper.innerHTML = bodyContent;
      document.body.appendChild(wrapper);

       const opt = {
        margin: 0,
        filename: name.replace(/\s+/g, '_') + '_Business_Card.pdf',
        image: { type: 'jpeg', quality: 1 },
        html2canvas: {
          scale: 1,
          useCORS: true,
          backgroundColor: '#ffffff'
        },
        jsPDF: {
          unit: 'mm',
          format: [95, 53],
          orientation: 'landscape'
        },
        pagebreak: { mode: ['avoid-all'] }
      };

       

      html2pdf()
        .set(opt)
        .from(wrapper)
        .save()
        .then(() => {
          document.body.removeChild(wrapper);
          document.head.removeChild(styleContainer);
          resolve();
        })
        .catch(err => {
          document.body.removeChild(wrapper);
          document.head.removeChild(styleContainer);
          reject(err);
        });

    } catch (error) {
      reject(error);
    }
  });
}

