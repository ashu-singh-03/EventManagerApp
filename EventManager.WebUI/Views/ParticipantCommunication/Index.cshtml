@{
    ViewData["Title"] = "Participants Communication";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center">
                <a href="/Event/Index" class="btn btn-outline-warning btn-sm d-flex align-items-center mb-2 mb-md-0 me-md-3 px-3">
                    <i class="fas fa-arrow-left me-2"></i> Back
                </a>
                <div class="vr d-none d-md-block me-3"></div>
                <div class="d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 p-2 rounded-circle me-3">
                        <i class="fas fa-users text-warning"></i>
                    </div>
                    <div>
                        <h1 class="h5 mb-1 text-dark fw-semibold">Participants Communication</h1>
                        <p class="mb-0 text-muted small">Manage participants and access credentials</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="card border-0 shadow-lg overflow-hidden">
        <!-- Card Header -->
        <div class="card-header bg-white border-bottom py-3">
            <div class="row align-items-center g-2">
                <div class="col-md-6">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 p-2 rounded-circle me-2">
                            <i class="fas fa-list-check text-warning"></i>
                        </div>
                        <div>
                            <h2 class="h6 mb-0 text-dark fw-semibold">Participants List</h2>
                            <p class="text-muted small mb-0 d-none d-md-block">View and manage all participant details</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex justify-content-md-end gap-2">
                        <div class="bulk-actions-container" style="display: none;">
                            <div class="btn-group">
                                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle d-flex align-items-center"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="badge bg-warning rounded-pill me-1 selected-count">0</span>
                                    <span class="d-none d-md-inline">Selected</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li>
                                        <a class="dropdown-item py-2" href="#" id="bulkGeneratePdf">
                                            <i class="fas fa-file-pdf text-danger me-2"></i>
                                            <span>Generate PDFs</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2" href="#" id="bulkSendEmails">
                                            <i class="fas fa-envelope text-warning me-2"></i>
                                            <span>Send Emails</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger" href="#" id="clearSelection">
                                            <i class="fas fa-times me-2"></i>
                                            Clear Selection
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm d-flex align-items-center" id="generateAllPdfs">
                            <i class="fas fa-file-pdf me-1"></i>
                            <span class="d-none d-md-inline">All PDFs</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Overview -->
        <div class="border-bottom">
            <div class="row g-0">
                <div class="col-4 col-sm-3 col-lg-2">
                    <div class="p-3 border-end text-center">
                        <div class="text-muted small mb-1">Total</div>
                        <div class="h6 mb-0 fw-bold text-dark" id="totalParticipants">0</div>
                    </div>
                </div>
                <div class="col-4 col-sm-3 col-lg-2">
                    <div class="p-3 border-end text-center">
                        <div class="text-muted small mb-1">With Tickets</div>
                        <div class="h6 mb-0 fw-bold text-success" id="ticketCount">0</div>
                    </div>
                </div>
                <div class="col-4 col-sm-3 col-lg-2">
                    <div class="p-3 border-end text-center">
                        <div class="text-muted small mb-1">Access</div>
                        <div class="h6 mb-0 fw-bold text-info" id="accessCount">0</div>
                    </div>
                </div>
                <div class="col-sm-3 col-lg-2 d-none d-sm-block">
                    <div class="p-3 text-center">
                        <div class="text-muted small mb-1">Pending</div>
                        <div class="h6 mb-0 fw-bold text-warning" id="pendingCount">0</div>
                    </div>
                </div>
                <div class="col-lg-4 d-none d-lg-block">
                    <div class="p-3 border-start">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-transparent border-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-0"
                                   placeholder="Search participants..."
                                   id="tableSearch">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Container -->
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0" id="participantsTable">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 40px; min-width: 40px;">
                            <div class="form-check mb-0">
                                <input class="form-check-input m-0" type="checkbox" id="selectAllCheckbox">
                            </div>
                        </th>
                        <th style="width: 100px; min-width: 100px;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-id-badge text-primary me-1"></i>
                                <span>Code</span>
                            </div>
                        </th>
                        <th style="width: 180px; min-width: 180px;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-user text-warning me-1"></i>
                                <span>Participant</span>
                            </div>
                        </th>
                        <th style="width: 120px; min-width: 120px;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-phone text-info me-1"></i>
                                <span>Contact</span>
                            </div>
                        </th>
                        <th style="width: 140px; min-width: 140px;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-building text-secondary me-1"></i>
                                <span>Company</span>
                            </div>
                        </th>
                        <th style="width: 140px; min-width: 140px;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-ticket-alt text-success me-1"></i>
                                <span>Ticket Type</span>
                            </div>
                        </th>
                        <th style="width: 160px; min-width: 160px;">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-door-open text-info me-1"></i>
                                <span>Access Points</span>
                            </div>
                        </th>
                        <th class="text-center" style="width: 120px; min-width: 120px;">
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-bolt text-warning me-1"></i>
                                <span>Actions</span>
                            </div>
                        </th>
                    </tr>
                </thead>
            </table>
        </div>

        <!-- Card Footer -->
        <div class="card-footer bg-white border-top py-2">
            <div class="row align-items-center">
                <div class="col-md-6 mb-1 mb-md-0">
                    <div class="text-muted small">
                        <i class="fas fa-info-circle text-warning me-1"></i>
                        <span class="d-none d-md-inline">Select participants for bulk actions</span>
                        <span class="d-md-none">Select for bulk actions</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex justify-content-md-end align-items-center gap-2">
                        <div class="d-none d-md-flex align-items-center">
                            <span class="text-muted small me-2">View:</span>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary active" data-view="table">
                                    <i class="fas fa-table"></i>
                                </button>
                                <button class="btn btn-outline-secondary" data-view="cards">
                                    <i class="fas fa-th-large"></i>
                                </button>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-warning">
                            <i class="fas fa-download me-1"></i>
                            <span class="d-none d-md-inline">Export</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Compact Table Styles */
    .card {
        border-radius: 8px;
    }

    .card-header {
        padding-top: 0.75rem !important;
        padding-bottom: 0.75rem !important;
    }

    .table {
        margin-bottom: 0;
        font-size: 0.85rem;
    }

    .table-sm th,
    .table-sm td {
        padding: 0.5rem 0.5rem !important;
    }

    .table thead th {
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
        border-bottom: 2px solid #f8f9fa;
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
        z-index: 10;
    }

    .table tbody td {
        vertical-align: middle;
        border-top: 1px solid rgba(0, 0, 0, 0.03);
    }

    .table tbody tr:hover {
        background-color: rgba(255, 193, 7, 0.05);
    }

    .table tbody tr.selected {
        background-color: rgba(13, 110, 253, 0.08);
    }

    /* Compact Form Controls */
    .form-check-input {
        width: 1.1em;
        height: 1.1em;
        margin-top: 0;
    }

    /* Compact Badges */
    .badge {
        font-size: 0.7em;
        font-weight: 500;
        padding: 0.25em 0.5em;
        line-height: 1.2;
    }

    /* Compact Buttons */
    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.8125rem;
    }

    .btn-group-sm > .btn {
        padding: 0.25rem 0.5rem;
    }

    /* Compact Dropdown */
    .dropdown-menu {
        font-size: 0.85rem;
        min-width: 180px;
    }

    .dropdown-item {
        padding: 0.375rem 0.75rem;
    }

    /* Stats Compact */
    .stats-container .p-3 {
        padding: 0.5rem !important;
    }

    /* Action Buttons Compact */
    .btn-group .btn {
        padding: 0.25rem 0.375rem;
    }

    /* Loading Overlay */
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .spinner-border-sm {
        width: 1.5rem;
        height: 1.5rem;
    }

    /* Responsive Adjustments */
    @@media (max-width: 1200px) {
        .table {
            font-size: 0.825rem;
        }

        .table-sm th,
        .table-sm td {
            padding: 0.375rem 0.5rem !important;
        }

        th:nth-child(2), td:nth-child(2) {
            width: 90px;
            min-width: 90px;
        }
        /* Code */
        th:nth-child(3), td:nth-child(3) {
            width: 160px;
            min-width: 160px;
        }
        /* Participant */
        th:nth-child(4), td:nth-child(4) {
            width: 110px;
            min-width: 110px;
        }
        /* Contact */
        th:nth-child(5), td:nth-child(5) {
            width: 130px;
            min-width: 130px;
        }
        /* Company */
        th:nth-child(6), td:nth-child(6) {
            width: 130px;
            min-width: 130px;
        }
        /* Ticket Type */
        th:nth-child(7), td:nth-child(7) {
            width: 150px;
            min-width: 150px;
        }
        /* Access Points */
    }

    @@media (max-width: 992px) {
        .d-lg-none-force {
            display: none !important;
        }

        .table-container {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .table {
            min-width: 900px;
        }
    }

    @@media (max-width: 768px) {
        .card-header {
            padding: 0.5rem !important;
        }

        .btn-sm {
            padding: 0.2rem 0.4rem;
            font-size: 0.75rem;
        }

        .badge {
            font-size: 0.65em;
            padding: 0.2em 0.4em;
        }

        .stats-container .p-3 {
            padding: 0.375rem !important;
        }

        .stats-container .h6 {
            font-size: 0.9rem;
        }
    }

    @@media (max-width: 576px) {
        .container-fluid {
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }

        .card-body {
            padding: 0.75rem !important;
        }

        .table-sm th,
        .table-sm td {
            padding: 0.25rem 0.375rem !important;
        }

        .bulk-actions-container {
            width: 100%;
        }

            .bulk-actions-container .btn-group {
                width: 100%;
            }
    }

    /* Scrollbar Styling */
    .table-responsive::-webkit-scrollbar {
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 3px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 3px;
    }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }

    /* Print-specific styles */
    @@media print {
        .card-header, .card-footer, .bulk-actions-container,
        #generateAllPdfs, .stats-container, .btn-group {
            display: none !important;
        }

        .table {
            font-size: 10pt !important;
        }

            .table th, .table td {
                padding: 0.25rem !important;
            }
    }
</style>


