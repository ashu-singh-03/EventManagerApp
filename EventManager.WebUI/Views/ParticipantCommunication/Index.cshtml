                // Initialize bulk action functionality
        function initializeBulkActions() {
            // Select All checkbox
            $('#selectAllCheckbox').on('click', function() {
                const isChecked = $(this).prop('checked');
                $('.participant-checkbox').prop('checked', isChecked);

                if (isChecked) {
                    // Add all visible rows to selection
                    participantsTable.rows({ search: 'applied' }).every(function() {
                        const data = this.data();
                        selectedParticipants.add(data.participantId);
                    });
                } else {
                    // Clear all selections
                    selectedParticipants.clear();
                }

                updateBulkActionsUI();
            });
